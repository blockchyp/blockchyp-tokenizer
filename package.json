{
  "name": "@blockchyp/blockchyp-tokenizer",
  "version": "1.1.0",
  "description": "BlockChyp Tokenizer",
  "main": "tokenizer.js",
  "scripts": {
    "build": "esbuild src/tokenizer.js --bundle --format=cjs --platform=browser --packages=external --target=es2017 --outfile=dist/tokenizer.js",
    "prod": "npm run build && esbuild src/global.js --bundle --format=iife --platform=browser --target=es2017 --outfile=dist/blockchyp-tokenizer-all.js && esbuild src/global.js --bundle --format=iife --platform=browser --target=es2017 --minify --outfile=dist/blockchyp-tokenizer-all.min.js",
    "lint": "eslint src",
    "test": "npm run build && jasmine --config=itest/support/jasmine.json",
    "dev": "http-server . -p 9000 -c-1",
    "prepare": "npm run prod"
  },
  "files": [
    "src/",
    "itest/",
    "dist/",
    "eslint.config.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blockchyp/blockchyp-tokenizer.git"
  },
  "keywords": [
    "es6",
    "payments",
    "blockchain"
  ],
  "author": "jeffreydpayne",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/blockchyp/blockchyp-tokenizer/issues"
  },
  "homepage": "https://github.com/blockchyp/blockchyp-tokenizer#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "http-server": "^14.1.1",
    "jasmine": "^5.13.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "js-base64": "^3.7.8"
  },
  "overrides": {
    "follow-redirects": "^1.16.1"
  }
}
